# Para emulador Android use 10.0.2.2 en lugar de localhost si el Backend corre en el equipo anfitrión.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8081

# Mantener en false para ejecutar con Expo Go. Cambiar a true únicamente en un
# development build que incluya la configuración nativa de FCM.
EXPO_PUBLIC_ENABLE_REMOTE_PUSH=false
